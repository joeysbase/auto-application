# Global settings for auto-app. Copy to .env (git-ignored) and edit:  cp .env.example .env
# Variables set in your shell win over this file. What to search stays in config/searches.yaml.
# Nested settings use "__" (AUTO_APP_JOBS__TTL_DAYS__UNFILTERED); maps are JSON on one line.

# ---- secrets ----
# Claude API key for Step 2 (`auto-app select`): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# DeepSeek API key, for filters whose model is deepseek-… (e.g. deepseek-chat): platform.deepseek.com → API keys
DEEPSEEK_API_KEY=

# ---- job TTL (applied by `auto-app purge`): days since any posting of the job was last seen ----
AUTO_APP_JOBS__TTL_DAYS__UNFILTERED=14        # not evaluated by Step 2 yet → deleted, with its postings
AUTO_APP_JOBS__TTL_DAYS__UN_RECOMMENDED=7     # Step 2 left it out → deleted
AUTO_APP_JOBS__TTL_DAYS__RECOMMENDED=30       # undecided, applied or not applied → archived (out of dedup)

# ---- posting-data retention (`auto-app purge`) ----
AUTO_APP_RETENTION__RAW_DAYS=7                # raw pages / records / screenshots, after a successful parse
AUTO_APP_RETENTION__SIGHTINGS_DAYS=30
AUTO_APP_RETENTION__LOGS_DAYS=30

# ---- Step 2 runs (`auto-app select`) ----
# auto = the Claude API when ANTHROPIC_API_KEY is set, otherwise your Claude Code login (`claude` CLI); or api / claude-cli
AUTO_APP_SELECT__RUNNER=auto
AUTO_APP_SELECT__CLAUDE_CLI=claude            # the Claude Code executable (a full path if it isn't on PATH)
AUTO_APP_SELECT__DEEPSEEK_BASE_URL=https://api.deepseek.com
AUTO_APP_SELECT__PARALLEL=3                   # agent runs at once
# USD per million tokens, for cost tracking and --max-cost — check anthropic.com/pricing (and DeepSeek's pricing
# page for deepseek-… models); add your filters' models
AUTO_APP_SELECT__PRICES={"claude-haiku-4-5-20251001": {"input_per_mtok": 1.0, "output_per_mtok": 5.0}}
AUTO_APP_SELECT__WEB_SEARCH_USD_PER_1000=10.0

# ---- evaluation (`filter audit`, `filter eval`) ----
# a filter's unlabelled "no" jobs may train its preference model only while its audited noise is surely below this
# (one-sided 95% exact bound); with no miss found, 59 audits show < 5%
AUTO_APP_SELECT__NOISE_LIMIT=0.05
# jobs per filter drawn by `filter audit` / by `d` in the app
AUTO_APP_SELECT__AUDIT_SIZE=30
AUTO_APP_SELECT__AUDIT_MORE=10

# ---- Step 3: applying (`apply …`) ----
# Claude (through your Claude Code CLI login) matches form questions to profile/answers.yaml and drafts free text
AUTO_APP_APPLY__MODEL=claude-sonnet-5
# a matched answer below this confidence goes to you (Needs input) instead
AUTO_APP_APPLY__MATCH_THRESHOLD=0.9
# the browser that fills and submits forms: visible by default (CAPTCHAs and logins are handed to you)
# AUTO_APP_APPLY__HEADLESS=false
# automated Simplify (simplify_auto): its one-time cookie notice is answered with "Essentials only" (or accept)
# AUTO_APP_APPLY__SIMPLIFY_CONSENT=essentials
# the browser-agent applier `agent` (docs/step3-agent.md): Claude through your Claude Code login; no token budget,
# a time limit per run (minutes) — starting a job, and fill only / submit
# AUTO_APP_APPLY__AGENT_MODEL=claude-opus-5-5
# AUTO_APP_APPLY__AGENT_TIME_LIMIT_START_MIN=10
# AUTO_APP_APPLY__AGENT_TIME_LIMIT_SUBMIT_MIN=20

# ---- the full-screen app (`job browse`) ----
# auto = follow your system's light / dark mode (switches live); or a fixed Textual theme, e.g. textual-light,
# ansi-light (your terminal's own colors), solarized-light, catppuccin-latte, nord, dracula — ctrl+p in the app lists them
AUTO_APP_UI__THEME=auto
# AUTO_APP_UI__LIGHT_THEME=textual-light
# AUTO_APP_UI__DARK_THEME=textual-dark

# ---- scheduled runs (`run --scheduled`, `schedule install`) ----
AUTO_APP_RUN_WINDOW__START=08:00
AUTO_APP_RUN_WINDOW__END=23:00
AUTO_APP_MIN_HOURS_BETWEEN_RUNS=6

# ---- retry pass for failed job pages ----
AUTO_APP_RETRY__MAX_FETCH_ATTEMPTS=3
AUTO_APP_RETRY__RETRY_WITHIN_DAYS=7
AUTO_APP_RETRY__MAX_SHARE_OF_HOURLY=0.5       # at most half a site's hourly limit per run

# ---- storage ----
# true = write postings/batches as files under data/raw/ instead of the database (like --debug-files)
AUTO_APP_DEBUG_FILES=false

# ---- where everything lives (default: the project folder) ----
# AUTO_APP_HOME=/path/to/another/folder
